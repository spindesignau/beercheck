APP_NAME=Beercheck
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev can use sqlite; production uses MariaDB (driver "mariadb").
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=cpaneluser_beercheck
# DB_USERNAME=cpaneluser_bcapp
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest job (venue sync can geocode for several minutes).
DB_QUEUE_RETRY_AFTER=2000

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Beercheck ---------------------------------------------------------
BEERCHECK_DEFAULT_LAT=-37.8136
BEERCHECK_DEFAULT_LNG=144.9631
BEERCHECK_PRICE_FRESHNESS_DAYS=180

# gd (always available on cPanel) or imagick
IMAGE_DRIVER=gd

# Shared hosting without symlink(): write uploads straight into the web root.
# PUBLIC_DISK_ROOT=/home/cpaneluser/public_html/storage
# PUBLIC_DISK_URL=https://beercheck.com.au/storage

# Liquor licence sync. Paste the current dataset download URLs.
SYNC_NSW_ENABLED=true
SYNC_NSW_URL=
SYNC_NSW_FORMAT=xlsx
SYNC_VIC_ENABLED=true
SYNC_VIC_URL=
SYNC_VIC_FORMAT=csv

# OSM Nominatim requires an identifying User-Agent with a contact address.
GEOCODING_ENABLED=true
GEOCODING_USER_AGENT="Beercheck venue sync (ops@your-domain.example)"
GEOCODING_MAX_PER_RUN=500
