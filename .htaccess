# The app lives inside public_html (document root = ./public). This blocks any
# web access to the project root (.env, vendor/, storage/ ...) via the main
# domain's paths. Only ./public is meant to be served.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
